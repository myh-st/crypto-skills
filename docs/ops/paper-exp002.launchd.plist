<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template: keep the EXP-002 (trend sleeves) PAPER server running across reboots and crashes (macOS launchd).
  Replace REPO, HOME_DIR and PYTHON (absolute interpreter path: python3 -c 'import sys; print(sys.executable)';
  launchd's PATH is minimal, so a bare python3 may resolve to an older system Python), copy to ~/Library/LaunchAgents/com.cryptoskills.paper-exp002.plist,
  then: launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.cryptoskills.paper-exp002.plist
  Stop:   launchctl bootout gui/$(id -u)/com.cryptoskills.paper-exp002   (sends SIGTERM → graceful)
  The server's instance lock prevents a second copy; startup recovery handles any downtime.
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.cryptoskills.paper-exp002</string>
  <key>WorkingDirectory</key><string>REPO</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/caffeinate</string><string>-is</string>
    <string>PYTHON</string><string>-m</string><string>crypto_eval</string>
    <string>paper-server</string><string>--database</string><string>HOME_DIR/paper-exp002.sqlite3</string><string>--port</string><string>8768</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardOutPath</key><string>HOME_DIR/paper-exp002.log</string>
  <key>StandardErrorPath</key><string>HOME_DIR/paper-exp002.log</string>
</dict>
</plist>
