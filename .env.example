# Local credentials for crypto-skills.
#
# Setup:
#   cp .env.example .env
#
# Then paste real credentials only into .env.
# .env is ignored by Git and must never be committed.
#
# IMPORTANT:
# - Never paste secret values into README/docs/tests.
# - Never commit .env.
# - The local runtime may migrate saved secrets to the OS credential store.
# - Azure endpoint/deployment/model/reasoning settings are configured in the app UI.
# - Target Azure provider for this feature: GPT-6 Luna with reasoning effort=max.

# TypeSafe / Jev
# Get the key from your TypeSafe account and paste it after '='.
TYPESAFE_API_KEY=

# OpenAI public API (optional; not required when using Azure AI Foundry).
OPENAI_API_KEY=

# Microsoft Azure AI Foundry / Azure OpenAI
# Paste the API key for the Azure resource/deployment used by the local app.
AZURE_OPENAI_API_KEY=

# Generic Responses-compatible provider (optional).
COMPATIBLE_AI_API_KEY=
