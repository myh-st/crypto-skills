{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/myh-st/crypto-skills/schemas/evidence-ledger.schema.json",
  "title": "Crypto Evidence Ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["evidence_ledger"],
  "properties": {
    "evidence_ledger": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observed_at",
        "source",
        "evidence_type",
        "quality",
        "supports"
      ],
      "properties": {
        "claim": {"type": "string", "minLength": 1},
        "metric": {"type": "string", "minLength": 1},
        "value": {"type": ["number", "string", "boolean", "null"]},
        "unit": {"type": ["string", "null"]},
        "venue": {"type": ["string", "null"]},
        "instrument": {"type": ["string", "null"]},
        "observed_at": {"type": "string", "format": "date-time"},
        "retrieved_at": {"type": ["string", "null"], "format": "date-time"},
        "freshness_seconds": {"type": ["number", "null"], "minimum": 0},
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "type"],
          "properties": {
            "provider": {"type": "string", "minLength": 1},
            "type": {
              "type": "string",
              "enum": ["primary", "aggregator", "charting", "derived", "news", "other"]
            },
            "uri": {"type": ["string", "null"]}
          }
        },
        "evidence_type": {
          "type": "string",
          "enum": [
            "price_structure",
            "spot_flow",
            "derivatives",
            "volatility",
            "options",
            "on_chain",
            "tokenomics",
            "macro",
            "catalyst",
            "relative_strength",
            "other"
          ]
        },
        "quality": {"type": "string", "enum": ["high", "medium", "low"]},
        "supports": {"type": "string", "enum": ["bull", "bear", "neutral"]},
        "interpretation": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "supports": {"type": "string", "enum": ["bull", "bear", "neutral"]},
            "confidence": {"type": "string", "enum": ["low", "medium", "high"]},
            "notes": {"type": "string"}
          }
        },
        "notes": {"type": "string"}
      }
    }
  }
}
