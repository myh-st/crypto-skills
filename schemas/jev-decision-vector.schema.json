{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jev-decision-vector.schema.json",
  "title": "Versioned Jev Decision Vector",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_hash",
    "model",
    "question_schema_version",
    "answers",
    "usage",
    "latency_ms",
    "observed_at"
  ],
  "properties": {
    "schema_version": {
      "const": "jev-decision-vector.v1"
    },
    "snapshot_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "question_schema_version": {
      "const": "jev-questions.v1"
    },
    "answers": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["type", "value"],
        "properties": {
          "type": {
            "enum": ["choice", "score", "noul"]
          },
          "value": {},
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "probabilities": {
            "type": "object",
            "additionalProperties": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "legend": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      }
    },
    "usage": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "input_tokens": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "output_tokens": {
          "type": ["integer", "null"],
          "minimum": 0
        }
      }
    },
    "latency_ms": {
      "type": "number",
      "minimum": 0
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
