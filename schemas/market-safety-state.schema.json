{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "market-safety-state.schema.json",
  "title": "Deterministic market safety assessment",
  "type": "object",
  "required": [
    "schema_version",
    "instrument_id",
    "market_type",
    "state",
    "price_confidence",
    "trusted_price",
    "structural_breakdown",
    "reasons",
    "metrics",
    "as_of",
    "restrictions"
  ],
  "properties": {
    "schema_version": {
      "const": "market-safety-state.v1"
    },
    "instrument_id": {
      "type": "string"
    },
    "market_type": {
      "enum": [
        "spot",
        "perpetual"
      ]
    },
    "state": {
      "enum": [
        "NORMAL",
        "VOLATILITY_ALERT",
        "CRASH_MODE",
        "RECOVERY",
        "MARKET_DATA_UNTRUSTED"
      ]
    },
    "price_confidence": {
      "enum": [
        "HIGH",
        "REDUCED",
        "LOW",
        "UNTRUSTED"
      ]
    },
    "trusted_price": {
      "type": [
        "number",
        "null"
      ]
    },
    "structural_breakdown": {
      "type": "boolean"
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "metrics": {
      "type": "object"
    },
    "crash_entered_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "as_of": {
      "type": "string"
    },
    "restrictions": {
      "type": "object",
      "required": [
        "new_entries",
        "averaging_down",
        "leverage_increase",
        "discretionary_full_exit",
        "protective_reduce",
        "emergency_liquidation_reduce"
      ],
      "properties": {
        "new_entries": {
          "type": "string",
          "enum": [
            "ALLOWED",
            "BLOCKED",
            "REDUCED_SIZE",
            "DEFERRED",
            "VELOCITY_LIMITED",
            "DEFERRED_UNLESS_EMERGENCY"
          ]
        },
        "averaging_down": {
          "type": "string",
          "enum": [
            "ALLOWED",
            "BLOCKED",
            "REDUCED_SIZE",
            "DEFERRED",
            "VELOCITY_LIMITED",
            "DEFERRED_UNLESS_EMERGENCY"
          ]
        },
        "leverage_increase": {
          "type": "string",
          "enum": [
            "ALLOWED",
            "BLOCKED",
            "REDUCED_SIZE",
            "DEFERRED",
            "VELOCITY_LIMITED",
            "DEFERRED_UNLESS_EMERGENCY"
          ]
        },
        "discretionary_full_exit": {
          "type": "string",
          "enum": [
            "ALLOWED",
            "BLOCKED",
            "REDUCED_SIZE",
            "DEFERRED",
            "VELOCITY_LIMITED",
            "DEFERRED_UNLESS_EMERGENCY"
          ]
        },
        "protective_reduce": {
          "type": "string",
          "enum": [
            "ALLOWED",
            "BLOCKED",
            "REDUCED_SIZE",
            "DEFERRED",
            "VELOCITY_LIMITED",
            "DEFERRED_UNLESS_EMERGENCY"
          ]
        },
        "emergency_liquidation_reduce": {
          "type": "string",
          "enum": [
            "ALLOWED",
            "BLOCKED",
            "REDUCED_SIZE",
            "DEFERRED",
            "VELOCITY_LIMITED",
            "DEFERRED_UNLESS_EMERGENCY"
          ]
        }
      },
      "additionalProperties": false
    },
    "quote": {
      "type": [
        "object",
        "null"
      ],
      "description": "Top-of-book snapshot the assessment used (PAPER API projection)."
    }
  },
  "additionalProperties": false
}
