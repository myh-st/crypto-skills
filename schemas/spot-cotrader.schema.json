        },
        "summary_th": {
          "type": "string"
        },
        "highlights": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "coin",
              "note"
            ],
            "properties": {
              "coin": {
                "type": "string"
              },
              "note": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "maxItems": 5
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "cost_usd": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "ai": {
      "type": "object",
      "required": [
        "enabled",
        "spent_today_usd",
        "daily_cap_usd",
        "spent_total_usd",
        "total_cap_usd",
        "blocked_reason",
        "jev_calls_today",
        "luna_calls_today",
