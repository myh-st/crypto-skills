{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "spot-cotrader.schema.json",
  "title": "Spot AI Co-Trader overview (GET /api/cotrader)",
  "description": "PAPER decision support. Signals use closed daily bars only; missing values are null, never zero. All *_pct, ret_*, dist_*, breadth, weight and rate values are fractions (0.12 = 12%). $defs.coin_detail is GET /api/cotrader/<BASE>; $defs.scorecard is GET /api/cotrader/scorecard.",
  "type": "object",
  "required": [
    "schema_version",
    "as_of",
    "last_close",
    "next_close",
    "regime",
    "briefing",
    "ai",
    "settings",
    "coins",
    "execution",
    "disclaimer"
  ],
  "properties": {
    "schema_version": {
      "const": "spot-cotrader.v1"
    },
    "as_of": {
      "type": "string",
      "format": "date-time"
    },
    "last_close": {
      "type": "string",
      "format": "date-time"
    },
    "next_close": {
      "type": "string",
      "format": "date-time"
    },
    "regime": {
      "$ref": "#/$defs/regime"
    },
    "briefing": {
      "$ref": "#/$defs/briefing"
    },
    "ai": {
      "$ref": "#/$defs/ai"
    },
    "settings": {
      "$ref": "#/$defs/settings"
    },
    "coins": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/coin"
      }
    },
    "execution": {
      "type": "object",
      "required": [
        "decide_at",
        "order_type",
        "exit",
        "fee_rate",
        "slippage_bps",
        "thin_liquidity"
      ],
      "properties": {
        "decide_at": {
          "type": "string"
        },
        "order_type": {
          "type": "string"
        },
        "exit": {
          "type": "string"
        },
        "fee_rate": {
          "type": "number"
        },
        "slippage_bps": {
          "type": "number"
        },
        "thin_liquidity": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "disclaimer": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "regime": {
      "type": "object",
      "required": [
        "label",
        "breadth",
        "hold",
        "total",
        "btc_state"
      ],
      "properties": {
        "label": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "RISK_ON",
            "MIXED",
            "RISK_OFF",
            null
          ]
        },
        "breadth": {
          "type": [
            "number",
            "null"
          ]
        },
        "hold": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "btc_state": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "HOLD",
            "CASH",
            "WATCH",
            null
          ]
        }
      },
      "additionalProperties": false
    },
    "briefing": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "as_of",
        "stance_market",
        "summary_th",
        "highlights",
        "model",
        "cost_usd"
      ],
      "properties": {
        "as_of": {
          "type": "string",
          "format": "date-time"
        },
        "stance_market": {
          "type": "string",
