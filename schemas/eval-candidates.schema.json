{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/myh-st/crypto-skills/schemas/eval-candidates.schema.json",
  "title": "Crypto Evaluation Candidate Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_id",
    "data_origin",
    "sampling_manifest",
    "candidates"
  ],
  "properties": {
    "schema_version": {"type": "string", "enum": ["crypto-eval.candidates.v1"]},
    "source_id": {"type": "string", "minLength": 1},
    "data_origin": {
      "type": "string",
      "enum": ["historical_archive", "forward_paper", "synthetic_fixture"]
    },
    "sampling_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scheduled_case_count", "included_case_count", "excluded_cases"],
      "properties": {
        "scheduled_case_count": {"type": "integer", "minimum": 1},
        "included_case_count": {"type": "integer", "minimum": 1},
        "excluded_cases": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_case_key", "asset", "scheduled_at", "reason", "rule_id"],
            "properties": {
              "source_case_key": {"type": "string", "minLength": 1},
              "asset": {"type": "string", "minLength": 1},
              "scheduled_at": {"type": "string", "format": "date-time"},
              "reason": {"type": "string", "minLength": 1},
              "rule_id": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_case_key",
          "asset",
          "instrument",
          "venue",
          "horizon",
          "as_of",
          "data_cutoff",
          "bar_interval_seconds",
          "horizon_bars",
          "snapshot"
        ],
        "properties": {
          "source_case_key": {"type": "string", "minLength": 1},
          "asset": {"type": "string", "minLength": 1},
          "instrument": {"type": "string", "enum": ["spot", "perpetual", "futures", "options"]},
          "venue": {"type": "string", "minLength": 1},
          "horizon": {
            "type": "string",
            "enum": ["scalp", "intraday", "swing", "position", "long_term"]
          },
          "as_of": {"type": "string", "format": "date-time"},
          "data_cutoff": {"type": "string", "format": "date-time"},
          "bar_interval_seconds": {"type": "integer", "minimum": 1},
          "horizon_bars": {"type": "integer", "minimum": 1},
          "market_regime": {"type": ["string", "null"]},
          "btc_regime": {"type": ["string", "null"]},
          "leverage_stress": {"type": ["string", "null"]},
          "liquidity_tier": {"type": ["string", "null"]},
          "benchmark_asset": {"type": ["string", "null"]},
          "snapshot": {"$ref": "#/$defs/snapshot"}
        }
      }
    }
  },
  "$defs": {
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candles"],
      "properties": {
        "candles": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/candle"}
        },
        "benchmark_candles": {
          "type": "array",
          "items": {"$ref": "#/$defs/candle"}
        },
        "funding": {"$ref": "#/$defs/observations"},
        "open_interest": {"$ref": "#/$defs/observations"},
        "oi": {"$ref": "#/$defs/observations"},
        "derivatives": {"$ref": "#/$defs/observations"},
        "options": {"$ref": "#/$defs/observations"},
        "on_chain": {"$ref": "#/$defs/observations"},
        "macro": {"$ref": "#/$defs/observations"},
        "benchmarks": {"$ref": "#/$defs/observations"},
        "news": {"$ref": "#/$defs/news_items"},
        "headlines": {"$ref": "#/$defs/news_items"},
        "articles": {"$ref": "#/$defs/news_items"},
        "data_availability": {"$ref": "#/$defs/data_availability"}
      }
    },
    "observations": {
      "type": "array",
      "items": {"$ref": "#/$defs/observation"}
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observed_at"],
      "properties": {
        "observed_at": {"type": "string", "format": "date-time"},
        "value": {"type": "number"},
        "rate": {"type": "number"},
        "funding_rate": {"type": "number"},
        "open_interest": {"type": "number"},
        "price": {"type": "number"},
        "volume": {"type": "number"},
        "notional": {"type": "number"},
        "quantity": {"type": "number"},
        "ratio": {"type": "number"},
        "long_short_ratio": {"type": "number"},
        "implied_volatility": {"type": "number"},
        "delta": {"type": "number"},
        "gamma": {"type": "number"},
        "theta": {"type": "number"},
        "vega": {"type": "number"},
        "bid": {"type": "number"},
        "ask": {"type": "number"},
        "asset": {"type": "string", "minLength": 1},
        "symbol": {"type": "string", "minLength": 1},
        "instrument": {"type": "string", "minLength": 1},
        "venue": {"type": "string", "minLength": 1},
        "unit": {"type": "string", "minLength": 1},
        "period": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1}
      }
    },
    "news_items": {
      "type": "array",
      "items": {"$ref": "#/$defs/news_item"}
    },
    "news_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["published_at", "available_at", "archive_id"],
      "properties": {
        "published_at": {"type": "string", "format": "date-time"},
        "available_at": {"type": "string", "format": "date-time"},
        "archive_id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "url": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "language": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "author": {"type": "string", "minLength": 1}
      }
    },
    "data_availability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "candles": {"type": "string", "enum": ["available", "partial"]},
        "funding": {"type": "string", "enum": ["available", "partial", "stale", "unavailable", "not_covered"]},
        "open_interest": {"type": "string", "enum": ["available", "partial", "stale", "unavailable", "not_covered"]},
        "news": {"type": "string", "enum": ["available", "partial", "stale", "unavailable", "not_covered"]},
        "options": {"type": "string", "enum": ["available", "partial", "stale", "unavailable", "not_covered"]},
        "on_chain": {"type": "string", "enum": ["available", "partial", "stale", "unavailable", "not_covered"]},
        "macro": {"type": "string", "enum": ["available", "partial", "stale", "unavailable", "not_covered"]},
        "benchmark": {"type": "string", "enum": ["available", "partial", "stale", "unavailable", "not_covered"]}
      }
    },
    "candle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["open_time", "close_time", "open", "high", "low", "close", "volume"],
      "properties": {
        "open_time": {"type": "string", "format": "date-time"},
        "close_time": {"type": "string", "format": "date-time"},
        "open": {"type": "number", "minimum": 0},
        "high": {"type": "number", "minimum": 0},
        "low": {"type": "number", "minimum": 0},
        "close": {"type": "number", "minimum": 0},
        "volume": {"type": "number", "minimum": 0}
      }
    }
  }
}
