{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "paper-order-view.schema.json",
  "title": "Unified PAPER order view",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "order_ref",
    "market_type",
    "instrument_id",
    "side",
    "order_type",
    "requested_quantity",
    "filled_quantity",
    "status",
    "source",
    "created_at",
    "cancellable",
    "amendable"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "paper-order-view.v1"
      ]
    },
    "order_ref": {
      "type": "string"
    },
    "order_id": {
      "type": "string"
    },
    "market_type": {
      "enum": [
        "spot",
        "perpetual"
      ]
    },
    "instrument_id": {
      "type": "string",
      "minLength": 10
    },
    "symbol": {
      "type": "string"
    },
    "display_symbol": {
      "type": "string"
    },
    "side": {
      "enum": [
        "long",
        "short",
        "buy",
        "sell"
      ]
    },
    "action": {
      "type": "string"
    },
    "order_type": {
      "enum": [
        "market",
        "limit"
      ]
    },
    "reduce_only": {
      "type": "boolean"
    },
    "requested_quantity": {
      "type": "number"
    },
    "filled_quantity": {
      "type": "number"
    },
    "remaining_quantity": {
      "type": "number"
    },
    "filled_pct": {
      "type": "number"
    },
    "limit_price": {
      "type": [
        "number",
        "null"
      ]
    },
    "status": {
      "enum": [
        "pending",
        "partially_filled",
        "working",
        "filled",
        "cancelled",
        "rejected"
      ]
    },
    "source": {
      "enum": [
        "AI",
        "USER",
        "SYSTEM"
      ]
    },
    "position_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "cancellable": {
      "type": "boolean"
    },
    "amendable": {
      "type": "boolean"
    }
  }
}
