{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "spot-wallet.schema.json",
  "title": "PAPER Spot wallet",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "available_quote_usdt",
    "cash_balance_usdt",
    "equity_usdt",
    "fees_usdt",
    "funding",
    "holdings_value_usdt",
    "leverage",
    "liquidation",
    "net_pnl_usdt",
    "quote",
    "realized_pnl_usdt",
    "reserved_quote_usdt",
    "schema_version",
    "slippage_usdt",
    "starting_balance_usdt",
    "unrealized_pnl_usdt"
  ],
  "properties": {
