      "enum": [
        "spot-wallet.v1"
      ]
    },
    "quote": {
      "enum": [
        "USDT"
      ]
    },
    "starting_balance_usdt": {
      "type": "number"
    },
    "cash_balance_usdt": {
      "type": "number"
    },
    "reserved_quote_usdt": {
      "type": "number"
    },
    "available_quote_usdt": {
      "type": "number"
    },
    "holdings_value_usdt": {
      "type": "number"
    },
    "equity_usdt": {
      "type": "number"
    },
    "realized_pnl_usdt": {
      "type": "number"
    },
    "unrealized_pnl_usdt": {
      "type": "number"
    },
    "fees_usdt": {
      "type": "number"
    },
    "slippage_usdt": {
      "type": "number"
    },
    "net_pnl_usdt": {
      "type": "number"
    },
    "leverage": {
      "type": "null"
    },
    "liquidation": {
      "type": "null"
    },
    "funding": {
      "type": "null"
    }
  }
}
